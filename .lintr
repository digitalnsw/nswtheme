linters: linters_with_defaults(
    line_length_linter = NULL,
    object_name_linter(styles = c("snake_case", "dotted.case", "CamelCase")),
    commented_code_linter = NULL,
    object_usage_linter = NULL
  )
exclusions: list(
    "vignettes/articles",
    "R/reactable_nswtheme.R" = list(object_name_linter = Inf)
  )
